# TypeSafe JEV MCP Server — Example Environment Configuration
# Copy this file to .env and set your real API key, or run:
#   typesafe-jev-mcp auth set-key
TYPESAFE_API_KEY=apikey_replace_with_your_key
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=15.0

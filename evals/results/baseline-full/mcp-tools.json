  {
    "name": "jev_evaluate",
    "title": null,
    "description": "Evaluate one or many structured System One questions (`noul`, `choice`, `score`, `box`) in parallel over `state` via a single `POST /v1/systemone` call (~100-150ms). All questions execute simultaneously with zero extra latency (Speculative Fan-Out). Each entry in `questions` maps a question ID to:\n- Noul (binary probability): `{\"type\": \"noul\", \"instructions\": \"...\", \"criteria\": {\"true\": \"...\", \"false\": \"...\"}}`\n- Choice (1 of up to 255 options): `{\"type\": \"choice\", \"instructions\": \"...\", \"criteria\": {\"opt_a\": \"...\", \"opt_b\": \"...\"}}`\n- Score (2-10 ordered rubric levels): `{\"type\": \"score\", \"instructions\": \"...\", \"criteria\": [\"level 0 (lowest)\", \"level 1\", \"level 2 (highest)\"]}`\n- Box (bounding box on image asset, Jev 1.14+): `{\"type\": \"box\", \"instructions\": \"the object in `photo`\"}`. All question types support images. In assets, map unique references to {\"path\": \"/absolute/photo.png\"} (local file uploaded to TypeSafe) or {\"format\": \"png\", \"data_base64\": \"...\"}. Put each reference in a string in state, instructions, or criteria. PNG/JPEG, 280..1568 px per side, <=16 MiB.",
    "input_schema": {
      "properties": {
        "state": {
          "title": "State"
        },
        "questions": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Questions",
          "type": "object"
        },
        "model": {
          "default": "jev-latest",
          "title": "Model",
          "type": "string"
        },
        "weights": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights"
        },
        "confidence_threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Threshold"
        },
        "assets": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assets"
        },
        "long_context": {
          "default": false,
          "title": "Long Context",
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "questions"
      ],
      "type": "object",
      "title": "jev_evaluateArguments"
    },
    "execution": null,
    "output_schema": {
      "type": "object",
      "additionalProperties": true,
      "title": "jev_evaluateDictOutput"
    },
    "icons": null,
    "annotations": null,
    "meta": null
